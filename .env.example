# Appwrite Cloud Client Configuration (non-secret client identifiers)
# Copy to .env and fill in your Appwrite Cloud project values when ready to enable cloud sync.
# The app works 100% offline with bundled studies even when these values are unset.
# APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# APPWRITE_PROJECT_ID=
# APPWRITE_DATABASE_ID=sola_scriptura
# APPWRITE_CATALOG_TABLE_ID=study_catalog
# APPWRITE_PROGRESS_TABLE_ID=user_progress
# APPWRITE_STUDY_BUCKET_ID=study_content
